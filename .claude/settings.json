{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          { "type": "command", "command": "/bin/sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate.sh\" branch_guard || exit 2" },
          { "type": "command", "command": "/bin/sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate.sh\" secret_guard || exit 2" },
          { "type": "command", "command": "/bin/sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate.sh\" test_gate || exit 2", "timeout": 120 }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Grep|Glob|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "/bin/sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate.sh\" secret_guard || exit 2" }
        ]
      }
    ]
  }
}
